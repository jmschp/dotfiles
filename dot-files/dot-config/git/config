# This is Git's per-user configuration file.
[user]
	name = Miguel Hargreaves Pimenta
	email = jmiguelpimenta@icloud.com
	signingkey = 7002813E67B2B7D0B02531A77416220F7444E470

[github]
	user = jmschp

[core]
	autocrlf = input
	excludesfile = ~/.config/git/ignore
	# pager = less -FRSX
	# filemode = false
	# trustctime = false
	# untrackedCache = true
	ignorecase = false
	editor = cursor --wait

[init]
	defaultBranch = main

[credential]
	helper = osxkeychain

[diff]
  tool = cursor

[difftool "cursor"]
  cmd = cursor --wait --diff $LOCAL $REMOTE

[merge]
  tool = cursor

[mergetool "cursor"]
  cmd = cursor --wait --merge $REMOTE $LOCAL $BASE $MERGED

[commit]
	gpgsign = true

[gpg]
	program = /opt/homebrew/bin/gpg

[filter "lfs"]
	clean = git-lfs clean -- %f
	process = git-lfs filter-process
	required = true
	smudge = git-lfs smudge -- %f

[filter "gitignoreSecret"]
	clean = "sed -E '/^[[:space:]]*#[[:space:]]*gitignoreSecret[[:space:]]*$/{n;s/^([^=:]*[=:])[[:space:]]*.*$/\\1 [REDACTED]/;}'"
	smudge = cat
	required = true
